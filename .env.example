# 复制为 .env 后填写真实值（.env 已在 .gitignore 中，禁止提交）
# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写数据库密码
DB_NAME=landlease

# ---------- 模型通道（阿里云百炼 DashScope，OpenAI 兼容模式）----------
DASHSCOPE_API_KEY=sk-请填写你的百炼APIKey
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_VL_MODEL=qwen3-vl-plus

# ---------- 开源通道（权重开源、可本地部署；比赛阶段经云端 OpenAI 兼容接口调用）----------
# 默认接硅基流动托管的 Qwen3-VL-32B-Instruct；正式环境改成政务网内 vLLM 地址即可
# 自建示例：OPENSOURCE_BASE_URL=http://10.0.0.20:8000/v1（vllm serve Qwen/Qwen3-VL-32B-Instruct）
OPENSOURCE_BASE_URL=https://api.siliconflow.cn/v1
OPENSOURCE_API_KEY=sk-请填写硅基流动APIKey
OPENSOURCE_VL_MODEL=Qwen/Qwen3-VL-32B-Instruct

# ---------- 判定与口径 ----------
# 自动通过置信度阈值（关键字段全对且校验通过才走批量确认）
AUTO_PASS_CONFIDENCE=0.90
# 核算口径版本（写入 rent_calc_trace，便于追溯重算）
CALC_RULE_VERSION=v1.2

# ---------- 可选：练习集/测试集目录（默认取项目内样本包）----------
# PRACTICE_DIR=E:/project/国有土地租赁/国有土地租赁模拟样本包_练习集/练习集
